# ─── Lab Notes Backend ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing actual secrets.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aniket_portfolio?schema=public

# Resend email API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# The "from" address for notification emails (must be a verified Resend domain)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Where moderation notifications are sent
FEEDBACK_NOTIFICATION_EMAIL=you@yourdomain.com
