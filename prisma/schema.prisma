// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Lab Notes
// ---------------------------------------------------------------------------

enum LabNoteStatus {
  PENDING
  APPROVED
  REJECTED
}

model LabNote {
  id String @id @default(cuid())

  // Core content
  rating  Int
  name    String?
  email   String?
  message String
  context String?

  // Moderation
  status     LabNoteStatus @default(PENDING)
  approvedAt DateTime?
  rejectedAt DateTime?

  // Anti-spam metadata (never exposed publicly)
  ipHash           String?
  userAgentSummary String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("lab_notes")
}
